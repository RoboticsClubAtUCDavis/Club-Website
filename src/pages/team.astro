---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const leadership = [
  { name: 'Jacob Denny', role: 'President', major: 'Mechanical Engineering', email: 'jcdenny@ucdavis.edu', linkedin: 'https://www.linkedin.com/in/jacob-denny-212a58198/', handshake: 'https://app.joinhandshake.com/profiles/jacobdenny?hscid=ad2b26b9-5697-4c89-9e3a-1c8c2ae18950', instagram: 'https://www.instagram.com/jacobcdenny/', website: 'https://jacobdenny.wixsite.com/website', img: `${base}/images/Team/Jacob_Denny.jpg` },
  { name: 'Zain Mustafa', role: 'Vice President', major: 'Electrical & Computer Engineering', email: 'zamustafa@ucdavis.edu', linkedin: 'https://www.linkedin.com/in/zain-a-mustafa/', handshake: 'https://app.joinhandshake.com/profiles/6wkbc9?hscid=d06bd13b-09fc-4085-86f2-e0d4139bc865', img: `${base}/images/Team/Zain_Mustafa.png` },
  { name: 'Hannah White', role: 'Executive Secretary', major: 'Mechanical Engineering', email: 'hawhite@ucdavis.edu', linkedin: 'https://www.linkedin.com/in/hannah-white-410529338/', handshake: 'https://app.joinhandshake.com/profiles/udc8jx', instagram: 'https://www.instagram.com/drakaina24/', img: `${base}/images/Team/Hannah_White.jpg` },
];

const subteamLeads = [
  { name: 'Ryan Torres', role: 'Mechanical Lead', subteam: 'Rover', img: '' },
  { name: 'Aisha Patel', role: 'Electrical Lead', subteam: 'Rover', img: '' },
  { name: 'Connor Lee', role: 'Software Lead', subteam: 'Autonomy', img: '' },
  { name: 'Maya Johnson', role: 'Vision Lead', subteam: 'Drone', img: '' },
];

---

<Layout title="Team & Contact" description="Meet the UC Davis Robotics Club team and find ways to get in touch.">

  <section id="team" class="page-hero section team-hero" style="border-bottom:none;">
    <div class="container">
      <p class="section-label">The people</p>
      <h1 class="section-title" style="font-size:clamp(2.5rem,5vw,4rem);">Our Team</h1>
      <p class="section-body">
        Students from every engineering discipline, united by a love of building things.
      </p>
    </div>
  </section>

  <!-- Leadership -->
  <section class="section team-content">
    <div class="container">
      <p class="section-label">Executive Board</p>
      <h2 class="section-title">Leadership</h2>
      <div class="team-grid leadership-grid" data-leadership-grid>
        {leadership.map(m => (
          <div class="member-card-wrap">
            <div class="member-card" role="group" tabindex="0" aria-label={`View more information about ${m.name}`}>
              <div class="member-photo">
                {m.img ? (
                  <img src={m.img} alt={m.name} loading="lazy" decoding="async" />
                ) : (
                  <div class="img-placeholder">[ {m.name} ]</div>
                )}
              </div>
              <div class="member-info">
                <h3 class="member-name">{m.name}</h3>
                <p class="member-role">{m.role}</p>
                <p class="member-major">{m.major}</p>
                {m.email && <a class="member-email" href={`mailto:${m.email}`}>{m.email}</a>}
              </div>
            </div>
            <aside class="member-detail" aria-label={`${m.name}'s links`}>
              <p class="detail-kicker">Connect / {m.role}</p>
              <h3 class="detail-name">{m.name}</h3>
              <p class="detail-major">{m.major}</p>
              <div class="detail-links">
                <a href={m.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <a href={m.handshake} target="_blank" rel="noopener noreferrer">Handshake</a>
                {m.instagram && <a href={m.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>}
                {m.website && <a href={m.website} target="_blank" rel="noopener noreferrer">Personal Website</a>}
              </div>
            </aside>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Subteam leads section temporarily disabled.
       Restore this block once the subteam lead roles are finalized.
  <section class="section" style="background:var(--surface); border-block:1px solid var(--border);">
    <div class="container">
      <p class="section-label">Subteams</p>
      <h2 class="section-title">Subteam Leads</h2>
      <div class="team-grid">
        {subteamLeads.map(m => (
          <div class="member-card">
            <div class="member-photo img-placeholder">[ {m.name} ]</div>
            <div class="member-info">
              <h3 class="member-name">{m.name}</h3>
              <p class="member-role">{m.role}</p>
              <p class="member-major" style="color:var(--gold)">{m.subteam} Team</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  -->

  <section id="contact" class="section contact-section" aria-labelledby="contact-title">
    <div class="container">
      <p class="section-label" data-contact-reveal="1">Get in touch</p>
      <h2 class="section-title" id="contact-title" data-contact-reveal="2">Contact the Club</h2>
      <div class="contact-layout">
        <div class="info-blocks">
          <div class="info-block" data-contact-reveal="3">
            <p class="info-label">Location</p>
            <p class="info-val">University of California, Davis<br />Davis, CA 95616</p>
          </div>
          <div class="info-block" data-contact-reveal="4">
            <p class="info-label">Meeting Times</p>
            <p class="info-val">General Meeting times TBD for upcoming Fall 2026.</p>
          </div>
          <div class="info-block" data-contact-reveal="5">
            <p class="info-label">Email</p>
            <p class="info-val"><a href="mailto:davisroboticsclub@gmail.com" class="email-link">davisroboticsclub@gmail.com</a></p>
          </div>
        </div>

        <div>
          <p class="section-label" data-contact-reveal="6">Stay connected</p>
          <div class="contact-card" data-contact-reveal="7">
            <p>Join the club Discord to stay up to date with meetings and events.</p>
            <div class="contact-actions">
              <a href="https://discord.gg/XA3rYvC9A9" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Join Discord</a>
              <a href="https://www.instagram.com/davisrobotics/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Instagram</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="section" style="background:var(--surface-2); border-top:1px solid var(--border);">
    <div class="container cta-inner">
      <div>
        <h2 class="section-title" style="font-size:2rem; margin-bottom:0.75rem;">Want to connect?</h2>
        <p class="section-body">We're always looking for passionate students to join.</p>
      </div>
      <a href="https://discord.gg/XA3rYvC9A9" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Join our Discord</a>
    </div>
  </section>

</Layout>

<style>
.team-hero { padding-bottom: 24px; }
.team-content { padding-top: 48px; }
.team-hero,
#contact { scroll-margin-top: calc(var(--nav-h) + 16px); }

.contact-section {
  background: var(--surface);
  border-block: 1px solid var(--border);
}

.contact-section.is-revealing [data-contact-reveal] {
  opacity: 0;
  transform: translateY(44px);
}

.contact-section.is-revealing [data-contact-reveal].is-visible {
  animation: contact-content-rise 0.65s cubic-bezier(0.2, 0.8, 0.25, 1) var(--contact-reveal-delay, 0s) both;
}

.contact-section [data-contact-reveal="2"] { --contact-reveal-delay: 0.08s; }
.contact-section [data-contact-reveal="3"] { --contact-reveal-delay: 0.12s; }
.contact-section [data-contact-reveal="4"] { --contact-reveal-delay: 0.2s; }
.contact-section [data-contact-reveal="5"] { --contact-reveal-delay: 0.28s; }
.contact-section [data-contact-reveal="6"] { --contact-reveal-delay: 0.2s; }
.contact-section [data-contact-reveal="7"] { --contact-reveal-delay: 0.28s; }

@keyframes contact-content-rise {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: flex-start;
  margin-top: 2rem;
}

.info-blocks {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.info-label {
  margin-bottom: 0.4rem;
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.info-val {
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1.65;
}

.email-link:hover {
  color: var(--text);
  text-decoration: underline;
}

.contact-card {
  margin-top: 1rem;
  padding: 2rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--surface-2);
}

.contact-card p {
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1.65;
}

.contact-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 1.25rem;
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 1.5rem;
  margin-top: 2.5rem;
}

.leadership-grid {
  display: flex;
  gap: 1.5rem;
  max-width: none;
  margin: 2.5rem 0 0;
  align-items: flex-start;
  overflow-x: clip;
  scrollbar-width: none;
}

.leadership-grid::-webkit-scrollbar { display: none; }

.member-card {
  appearance: none;
  text-align: left;
  font: inherit;
  width: 220px;
  height: 370px;
  max-width: none;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  transition: border-color 0.2s, transform 0.2s;
}

.member-card-wrap {
  display: grid;
  grid-template-columns: 220px 0;
  gap: 0;
  width: 220px;
  flex: 0 0 220px;
  transition: grid-template-columns 0.2s ease, width 0.2s ease, flex-basis 0.2s ease;
}

.leadership-grid .member-card-wrap {
  opacity: 0;
  transform: translateY(90px) rotate(2deg);
}

.leadership-grid.is-visible .member-card-wrap {
  animation: leadership-card-fly-in 0.45s cubic-bezier(0.2, 0.8, 0.25, 1) forwards;
}

.leadership-grid.is-visible .member-card-wrap:nth-child(2) { animation-delay: 0.1s; }
.leadership-grid.is-visible .member-card-wrap:nth-child(3) { animation-delay: 0.2s; }

@keyframes leadership-card-fly-in {
  to {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .leadership-grid .member-card-wrap,
  .leadership-grid .member-card-wrap:nth-child(2),
  .leadership-grid .member-card-wrap:nth-child(3) {
    opacity: 1;
    transform: none;
    animation: none;
  }
}

.member-card:hover,
.member-card:focus-visible {
  border-color: var(--gold-dim);
  transform: translateY(-2px);
}

.member-photo { height: 200px; overflow: hidden; background: var(--surface-2); }

.member-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: 0.8rem;
  text-align: center;
  padding: 1rem;
}

.member-info {
  flex: 1;
  padding: 1rem 1.1rem 1.25rem;
}

.member-name {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 0.25rem;
}

.member-role {
  font-size: 0.78rem;
  color: var(--gold);
  font-family: var(--font-mono);
  letter-spacing: 0.06em;
  margin-bottom: 0.25rem;
}

.member-major { font-size: 0.75rem; color: var(--text-dim); }

.member-email {
  display: inline-block;
  margin-top: 0.35rem;
  font-family: var(--font-display);
  font-size: 0.90rem;
  color: var(--text-dim);
}

.member-email:hover {
  color: #003366;
  text-decoration: underline;
}

.member-detail {
  grid-column: 2;
  width: 280px;
  align-self: start;
  padding: 1.25rem;
  border: 1px solid var(--gold-dim);
  border-left: 3px solid var(--gold);
  background: var(--surface-2);
  box-shadow: 18px 18px 40px rgba(0,0,0,0.25);
  opacity: 0;
  visibility: hidden;
  transform: translateX(-12px);
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
}

.member-detail[hidden] {
  display: none;
}

.leadership-grid.is-entering .member-card-wrap .member-detail {
  opacity: 0;
  visibility: hidden;
  transform: translateX(-12px);
  transition: none;
  pointer-events: none;
}

.member-card-wrap:hover .member-detail,
.member-card-wrap:focus-within .member-detail {
  opacity: 1;
  visibility: visible;
  transform: translateX(0);
}

.member-card-wrap.is-dismissed .member-detail,
.member-card-wrap.is-dismissed:hover .member-detail,
.member-card-wrap.is-dismissed:focus-within .member-detail {
  opacity: 0;
  visibility: hidden;
  transform: translateX(-12px);
  pointer-events: none;
}

.member-card-wrap:hover,
.member-card-wrap:focus-within {
  grid-template-columns: 220px 280px;
  gap: 1rem;
  width: 516px;
  flex-basis: 516px;
}

.leadership-grid.is-entering .member-card-wrap,
.leadership-grid.is-entering .member-card-wrap:hover,
.leadership-grid.is-entering .member-card-wrap:focus-within {
  grid-template-columns: 220px 0;
  gap: 0;
  width: 220px;
  flex-basis: 220px;
}

.detail-kicker {
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 0.65rem;
}

.detail-name {
  color: var(--text);
  font-size: 1.2rem;
  margin-bottom: 0.3rem;
}

.detail-major {
  color: var(--text-muted);
  font-size: 0.8rem;
  line-height: 1.5;
  margin-bottom: 1rem;
}

.detail-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1rem;
}

.detail-links a {
  color: var(--gold);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.detail-links a:hover { color: var(--text); }

@media (max-width: 700px) {
  .leadership-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .leadership-grid.is-visible .member-card-wrap,
  .leadership-grid.is-entering .member-card-wrap {
    opacity: 1;
    transform: none;
    animation: none;
  }
  .member-card-wrap,
  .member-card {
    width: 100%;
    max-width: none;
  }
  .member-card {
    height: auto;
    min-height: 370px;
  }
  .member-card-wrap {
    display: block;
    flex: none;
  }
  .member-card-wrap:hover,
  .member-card-wrap:focus-within {
    width: 100%;
    flex-basis: auto;
  }
  .member-detail {
    position: static;
    width: auto;
    margin-top: 0.75rem;
    opacity: 1;
    visibility: visible;
    transform: none;
  }
}

.cta-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}

@media (max-width: 720px) {
  .contact-layout {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
}
</style>

<script>
const memberCardWrappers = document.querySelectorAll<HTMLElement>('.member-card-wrap');
const leadershipGrid = document.querySelector<HTMLElement>('[data-leadership-grid]');
const contactSection = document.querySelector<HTMLElement>('.contact-section');
const contactRevealItems = contactSection?.querySelectorAll<HTMLElement>('[data-contact-reveal]');

if (contactSection && contactRevealItems?.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
  contactSection.classList.add('is-revealing');
  const contactObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      entry.target.classList.toggle('is-visible', entry.isIntersecting);
    });
  }, { threshold: 0.2 });

  contactRevealItems.forEach(item => contactObserver.observe(item));
}

if (leadershipGrid) {
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobileLayout = window.matchMedia('(max-width: 700px)').matches;
  const lastCard = memberCardWrappers[memberCardWrappers.length - 1];

  lastCard?.addEventListener('animationend', event => {
    if (event.animationName === 'leadership-card-fly-in') {
      leadershipGrid.classList.remove('is-entering');
    }
  });

  if (reducedMotion || mobileLayout) {
    leadershipGrid.classList.add('is-visible');
  } else {
    const leadershipObserver = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        leadershipGrid.classList.remove('is-visible');
        void leadershipGrid.offsetWidth;
        leadershipGrid.classList.add('is-entering', 'is-visible');
      } else {
        leadershipGrid.classList.remove('is-entering', 'is-visible');
      }
    }, { threshold: 0.2 });

    leadershipObserver.observe(leadershipGrid);
  }
}

memberCardWrappers.forEach(wrapper => {
  const detail = wrapper.querySelector<HTMLElement>('.member-detail');

  if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

  wrapper.querySelectorAll<HTMLAnchorElement>('.detail-links a').forEach(link => {
    link.addEventListener('click', () => {
      wrapper.classList.add('is-dismissed');
      detail?.setAttribute('hidden', '');
    });
  });

  wrapper.addEventListener('mouseenter', () => {
    wrapper.classList.remove('is-dismissed');
    detail?.removeAttribute('hidden');
  });
  wrapper.addEventListener('mouseleave', () => {
    wrapper.classList.add('is-dismissed');
    detail?.setAttribute('hidden', '');
  });
  wrapper.addEventListener('focusout', event => {
    if (!wrapper.contains(event.relatedTarget as Node | null)) {
      wrapper.classList.remove('is-dismissed');
      detail?.removeAttribute('hidden');
    }
  });
});
</script>

