---
import { Image } from 'astro:assets';

const base = import.meta.env.BASE_URL;
const links = [
  { href: base,           label: 'Home' },
  { href: `${base}about`,      label: 'About' },
  { href: `${base}projects`,   label: 'Projects' },
  { href: `${base}events`,     label: 'Events' },
  { href: `${base}gallery`,    label: 'Gallery' },
  { href: `${base}team`,       label: 'Team' },
  { href: `${base}contact`,    label: 'Contact' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const homePath = base.replace(/\/$/, '') || '/';
---

<nav class="nav">
  <div class="nav-inner container">
    <a href={base} class="nav-logo">
      <Image
        src={`${base}images/Logos/Metal_Logo.png`}
        alt="UC Davis Robotics Club"
        class="nav-logo-img"
        width="4048"
        height="1308"
      />
    </a>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>

    <ul class="nav-links" id="navLinks">
      {links.map(l => (
        <li>
          <a
            href={l.href}
            class:list={['nav-link', { active: l.label === 'Home' ? current === homePath : current === l.href.replace(/\/$/, '') || current.startsWith(`${l.href.replace(/\/$/, '')}/`) }]}
          >{l.label}</a>
        </li>
      ))}
      <li>
        <a href={`${base}join`} class="btn btn-primary nav-cta">Join Us</a>
      </li>
    </ul>
  </div>
</nav>

<style>
.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 100px;
  background: rgba(10, 12, 16, 0.88);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  z-index: 100;
}

.nav-inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.75rem 2rem;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--font-display);
  font-size: 0.95rem;
  font-weight: 400;
  white-space: nowrap;
  color: var(--text);
  margin-right: auto;
  min-width: 0;
}

.nav-logo-img {
  height: 90px;     
  width: auto;    
  object-fit: contain;
  display: block;
  transition: transform 0.2s ease;
  transform-origin: center;
}

.nav-logo:hover .nav-logo-img { transform: scale(1.08); }

.nav-links {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  list-style: none;
}

.nav-link {
  padding: 0.4rem 0.75rem;
  font-size: 1.25rem;
  color: var(--text-muted);
  border-radius: 4px;
  transition: color 0.15s, font-size 0.15s;
}
.nav-link:hover { color: var(--text); font-size: 1.4rem; font-weight: 700; }
.nav-link.active { color: var(--gold); font-size: 1.4rem; font-weight: 700; }

.nav-cta { margin-left: 2rem; padding: 0.5rem 1.1rem; font-size: 0.82rem; }

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  flex: 0 0 auto;
  margin-left: 1rem;
}
.nav-toggle span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--text);
  transition: 0.2s;
}

@media (max-width: 860px) {
  .nav { overflow-x: clip; }
  .nav-inner {
    padding-inline: 1.25rem;
    overflow: hidden;
  }
  .nav-toggle {
    display: flex;
    margin-left: 0.75rem;
  }
  .nav-logo {
    flex: 1 1 auto;
    overflow: hidden;
  }
  .nav-logo-img {
    height: 54px;
    max-width: 100%;
  }
  .nav-logo:hover .nav-logo-img { transform: none; }
  .nav-links {
    display: none;
    position: absolute;
    top: var(--nav-h);
    left: 0; right: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 1rem 1.5rem 1.5rem;
  }
  .nav-links.open { display: flex; }
  .nav-link { padding: 0.65rem 0; width: 100%; }
  .nav-cta { margin-top: 0.75rem; }
}
</style>

<script>
const toggle = document.getElementById('navToggle');
const links  = document.getElementById('navLinks');
toggle?.addEventListener('click', () => links?.classList.toggle('open'));
</script>
