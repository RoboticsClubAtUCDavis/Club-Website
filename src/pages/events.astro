--- // Closing boundary for javascript/typescript

<Layout title="Events" description="Future events and past workshops from UC Davis Robotics Club.">
  <section class="page-hero section events-page-hero">
    <div class="container">
      <div class="events-intro">
        <p class="section-label">Schedule</p>
        <h1 class="section-title" style="font-size:clamp(2.5rem,5vw,4rem);">Upcoming Events</h1>
        <p class="section-body">
          Future club meetings, workshops, and project sessions. Check back for confirmed
          dates and room numbers as they are announced.
        </p>
      </div>
      <div class="event-list upcoming-event-list" data-upcoming-events>
        {futureEvents.map(event => (
          <article class="event-row" data-event-row data-end-time={event.endAt}>
            <div class="event-date-col">
              <p class="event-date event-reveal-item" style="--event-reveal-delay: 0s">{event.date}</p>
              <p class="event-time event-reveal-item" style="--event-reveal-delay: 0.12s">{event.time}</p>
            </div>
            <div class="event-info">
              <h3 class="event-title event-reveal-item" style="--event-reveal-delay: 0.24s">{event.title}</h3>
              {event.mapUrl ? (
                <a class="event-location event-reveal-item" style="--event-reveal-delay: 0.36s" href={event.mapUrl} target="_blank" rel="noopener noreferrer">
                  {event.location}
                </a>
              ) : (
                <p class="event-location event-reveal-item" style="--event-reveal-delay: 0.36s">{event.location}</p>
              )}
              <p class="event-desc event-reveal-item" style="--event-reveal-delay: 0.48s">
                {event.desc}
                {event.linkUrl && (
                  <>
                    {' '}
                    <a class="event-desc-link" href={event.linkUrl} target="_blank" rel="noopener noreferrer">
                      {event.linkText || 'Learn more'}
                    </a>
                  </>
                )}
              </p>
            </div>
            <span class="event-badge event-reveal-item" style="--event-reveal-delay: 0.6s" data-tag={event.tag.toLowerCase()}>{event.tag}</span>
          </article>
        ))}
      </div>
      <div class="events-banner" role="region" aria-label="Photos from the Engineering Club Fair">
        <div class="events-banner-stage">
          <div class="events-banner-track" data-event-banner-track>
            {[...eventBannerImages, ...eventBannerImages, ...eventBannerImages].map((image, index) => (
              <img
                src={image.src}
                alt={image.alt}
                aria-hidden={index < eventBannerImages.length || index >= eventBannerImages.length * 2 ? 'true' : undefined}
                data-event-banner-image
                data-slide-index={index}
              />
            ))}
          </div>
        </div>
        <div class="events-banner-dots" role="group" aria-label="Select a photo">
          {eventBannerImages.map((image, index) => (
            <button
              class="events-banner-dot"
              type="button"
              aria-label={`Show photo ${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
              data-event-banner-dot={index}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section events-band">
    <div class="container">
      <p class="section-label">Archive</p>
      <h2 class="section-title">Recent Events</h2>
      <div class="event-list" data-past-events>
        <p class="past-empty" data-past-empty>No past events yet.</p>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--surface-2); border-block:1px solid var(--border);">
    <div class="container events-cta">
      <p class="section-label">Stay updated</p>
      <h2 class="section-title" style="font-size:2rem;">Want event announcements?</h2>
      <p class="section-body">
        Join the club Discord or contact the team for the latest meeting times and event details.
      </p>
      <div class="cta-actions">
        <a href="https://discord.gg/XA3rYvC9A9" target="_blank" rel="noopener" class="btn btn-primary">Join Discord</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.event-list {
  display: flex;
  flex-direction: column;
  margin-top: 2.5rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
}

.events-banner {
  width: min(100%, 900px);
  margin: 2rem auto 2rem;
  opacity: 0;
  transform: translateY(70px);
  animation: events-content-rise 0.7s cubic-bezier(0.2, 0.75, 0.25, 1) 0.85s forwards;
}

.events-banner-stage {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.08) 3%, rgba(0, 0, 0, 0.28) 7%, rgba(0, 0, 0, 0.65) 11%, #000 15%, #000 85%, rgba(0, 0, 0, 0.65) 89%, rgba(0, 0, 0, 0.28) 93%, rgba(0, 0, 0, 0.08) 97%, transparent 100%);
  mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.08) 3%, rgba(0, 0, 0, 0.28) 7%, rgba(0, 0, 0, 0.65) 11%, #000 15%, #000 85%, rgba(0, 0, 0, 0.65) 89%, rgba(0, 0, 0, 0.28) 93%, rgba(0, 0, 0, 0.08) 97%, transparent 100%);
}

.events-intro {
  opacity: 0;
  transform: translateY(70px);
  animation: events-content-rise 0.7s cubic-bezier(0.2, 0.75, 0.25, 1) 0.05s forwards;
}

.upcoming-event-list {
  opacity: 0;
  transform: translateY(70px);
  animation: events-content-rise 0.7s cubic-bezier(0.2, 0.75, 0.25, 1) 0.35s forwards;
}

@keyframes events-content-rise {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.events-page-hero {
  padding-top: calc(var(--nav-h) + 24px);
}

.events-banner-track {
  display: flex;
  align-items: center;
  gap: clamp(0.5rem, 2vw, 1rem);
  width: 100%;
  height: 100%;
  transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.25, 1);
}

.events-banner img {
  flex: 0 0 70%;
  display: block;
  min-width: 0;
  height: 100%;
  object-fit: contain;
  border-radius: 8px;
  opacity: 0.38;
  transform: scale(0.9);
  transition: opacity 0.35s, transform 0.35s;
}

.events-banner img.is-focal {
  opacity: 1;
  transform: scale(1);
}

.events-banner-dots {
  display: grid;
  grid-auto-flow: column;
  justify-content: center;
  gap: 0.35rem;
  margin-top: 0.4rem;
}

.events-banner-dot {
  display: grid;
  width: 32px;
  height: 32px;
  padding: 0;
  place-items: center;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.events-banner-dot::before {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--text-muted);
  content: '';
  transition: transform 0.2s, background-color 0.2s;
}

.events-banner-dot:hover::before,
.events-banner-dot[aria-current='true']::before {
  transform: scale(1.6);
  background: var(--gold);
}

.events-banner-dot:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: -2px;
}

.event-row {
  display: grid;
  grid-template-columns: 180px 1fr auto;
  align-items: center;
  gap: 1.5rem;
  padding: 1.4rem 1.75rem;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  transition: background 0.15s, transform 0.2s ease;
}

.event-reveal-item {
  opacity: 0;
  transform: translateY(70px);
}

.event-row.is-visible .event-reveal-item {
  animation: event-row-fly-in 0.65s cubic-bezier(0.2, 0.8, 0.25, 1) var(--event-reveal-delay) both;
}

@keyframes event-row-fly-in {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.event-row:last-child { border-bottom: none; }
.event-row:hover {
  background: var(--surface-2);
  transform: scale(1.02);
  position: relative;
  z-index: 1;
}

.event-date {
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text);
}

.event-time {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-muted);
  margin-top: 0.25rem;
}

.event-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 0.3rem;
}

.event-info {
  min-width: 0;
}

.event-location {
  display: inline-block;
  color: var(--text-muted);
  font-size: 0.8rem;
  text-decoration: underline;
  text-underline-offset: 0.15rem;
}

.event-location:hover {
  color: var(--gold);
}

.event-desc {
  color: var(--text-muted);
  font-size: 0.8rem;
  line-height: 1.5;
  margin-top: 0.35rem;
  max-width: 52ch;
}

.event-desc-link {
  color: var(--gold);
  text-decoration: underline;
  text-underline-offset: 0.15rem;
}

.event-desc-link:hover {
  color: #e0bc60;
}

.event-badge {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.25em 0.75em;
  border-radius: 999px;
  white-space: nowrap;
  background: rgba(201,168,76,0.1);
  color: var(--gold);
  border: 1px solid rgba(201,168,76,0.25);
}

.event-badge[data-tag='competition'] {
  background: rgba(220, 38, 38, 0.12);
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.3);
}

.event-badge[data-tag='school events'] {
  background: rgba(37, 99, 235, 0.12);
  color: #3b82f6;
  border-color: rgba(59, 130, 246, 0.3);
}

.event-badge[data-tag='meeting'] {
  background: rgba(22, 163, 74, 0.12);
  color: #22c55e;
  border-color: rgba(34, 197, 94, 0.3);
}

.event-badge[data-tag='community events'] {
  background: rgba(163, 118, 22, 0.12);
  color: #e69927;
  border-color: rgba(197, 132, 34, 0.3);
}

.events-band {
  background: var(--surface);
  border-block: 1px solid var(--border);
}

.past-empty {
  padding: 1.4rem 1.75rem;
  color: var(--text-muted);
  font-size: 0.85rem;
}

.events-cta {
  max-width: 680px;
}

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}

@media (max-width: 650px) {
  .event-row {
    grid-template-columns: 1fr;
  }

  .event-date-col {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .event-badge {
    width: fit-content;
  }

}

@media (prefers-reduced-motion: reduce) {
  .events-banner,
  .events-intro,
  .upcoming-event-list {
    opacity: 1;
    transform: none;
    animation: none;
  }

  .events-banner-track,
  .events-banner img {
    transition: none;
  }

  .events-banner-dot::before {
    transition: none;
  }


  .event-reveal-item {
    opacity: 1;
    transform: none;
    animation: none;
  }
}
</style>

<script>
  const bannerTrack = document.querySelector<HTMLElement>('[data-event-banner-track]');
  const bannerImages = bannerTrack
    ? Array.from(bannerTrack.querySelectorAll<HTMLElement>('[data-event-banner-image]'))
    : [];
  const bannerImageCount = bannerImages.length / 3;
  const bannerDots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-event-banner-dot]'));
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let bannerPosition = bannerImageCount;
  let bannerMoveLocked = false;
  let bannerMoveTimer: number | undefined;

  const updateBanner = (animate = true) => {
    if (!bannerTrack || bannerImages.length === 0) return;

    const imageWidth = bannerImages[0].offsetWidth;
    const gap = parseFloat(getComputedStyle(bannerTrack).gap) || 0;
    const stageWidth = bannerTrack.parentElement?.clientWidth ?? imageWidth;
    const centerOffset = (stageWidth - imageWidth) / 2;
    bannerTrack.style.transition = animate ? '' : 'none';
    bannerTrack.style.transform = `translateX(-${bannerPosition * (imageWidth + gap) - centerOffset}px)`;
    bannerImages.forEach((image, index) => {
      image.classList.toggle('is-focal', index === bannerPosition);
    });
    const currentSlide = ((bannerPosition - bannerImageCount) % bannerImageCount + bannerImageCount) % bannerImageCount;
    bannerDots.forEach((dot, index) => {
      dot.setAttribute('aria-current', index === currentSlide ? 'true' : 'false');
    });
  };

  const finishBannerMove = () => {
    if (bannerPosition >= bannerImageCount * 2) {
      bannerPosition = bannerImageCount;
      updateBanner(false);
    } else if (bannerPosition < bannerImageCount) {
      bannerPosition = bannerImageCount * 2 - 1;
      updateBanner(false);
    }
    bannerMoveLocked = false;
    bannerMoveTimer = undefined;
  };

  const moveBanner = (direction: number) => {
    if (!bannerTrack || bannerImageCount === 0 || bannerMoveLocked) return;

    bannerMoveLocked = true;
    bannerPosition += direction;
    updateBanner();
    bannerMoveTimer = window.setTimeout(finishBannerMove, prefersReducedMotion ? 0 : 750);
  };

  const selectBanner = (index: number) => {
    if (!bannerTrack || bannerMoveLocked) return;

    bannerPosition = bannerImageCount + index;
    updateBanner();
    bannerMoveLocked = true;
    bannerMoveTimer = window.setTimeout(finishBannerMove, prefersReducedMotion ? 0 : 750);
  };

  bannerDots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      if (bannerMoveTimer !== undefined) window.clearTimeout(bannerMoveTimer);
      bannerMoveLocked = false;
      selectBanner(index);
    });
  });

  updateBanner(false);

  if (bannerTrack && bannerImageCount > 0 && !prefersReducedMotion) {
    window.setInterval(() => moveBanner(1), 5000);
  }

  window.addEventListener('resize', () => updateBanner(false));

  const upcomingEvents = document.querySelector<HTMLElement>('[data-upcoming-events]');
  const pastEvents = document.querySelector<HTMLElement>('[data-past-events]');
  const pastEmpty = document.querySelector<HTMLElement>('[data-past-empty]');

  const movePastEvents = () => {
    if (!upcomingEvents || !pastEvents || !pastEmpty) return;

    upcomingEvents.querySelectorAll<HTMLElement>('[data-event-row]').forEach(row => {
      const endTime = row.dataset.endTime;
      if (endTime && new Date(endTime).getTime() <= Date.now()) {
        pastEvents.appendChild(row);
      }
    });

    const archivedRows = Array.from(pastEvents.querySelectorAll<HTMLElement>('[data-event-row]'));
    archivedRows.sort((first, second) =>
      new Date(second.dataset.endTime ?? '').getTime() - new Date(first.dataset.endTime ?? '').getTime()
    );
    archivedRows.forEach(row => pastEvents.appendChild(row));
    pastEmpty.hidden = pastEvents.querySelector('[data-event-row]') !== null;
  };

  movePastEvents();

  const eventRows = document.querySelectorAll<HTMLElement>('[data-event-row]');

  if (eventRows.length) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      eventRows.forEach(row => row.classList.add('is-visible'));
    } else {
      const eventObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting && entry.target instanceof HTMLElement) {
            entry.target.classList.add('is-visible');
            eventObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      eventRows.forEach(row => eventObserver.observe(row));
    }
  }

  const nextEventEnd = Array.from(document.querySelectorAll<HTMLElement>('[data-event-row]'))
    .map(row => row.dataset.endTime ? new Date(row.dataset.endTime).getTime() : Infinity)
    .filter(endTime => endTime > Date.now())
    .sort((first, second) => first - second)[0];

  if (nextEventEnd) {
    window.setTimeout(() => window.location.reload(), nextEventEnd - Date.now() + 100);
  }
</script>
