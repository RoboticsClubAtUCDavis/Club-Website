---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'UC Davis Robotics Club is a student engineering organization building combat robots, drones, and autonomous systems at UC Davis.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(`${base}images/Logos/Metal_Logo.png`, siteUrl);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UC Davis Robotics Club',
  alternateName: 'Davis Robotics Club',
  url: siteUrl.href,
  logo: socialImage.href,
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Davis',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  memberOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of California, Davis',
    url: 'https://www.ucdavis.edu/',
  },
  sameAs: [
    'https://www.instagram.com/davisrobotics/',
    'https://github.com/RoboticsClubAtUCDavis',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="w0H8XJFpg9SZL6wRZ8jpCq9SqbVmqyFl0K_GZ1zBEWA" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UC Davis Robotics Club" />
    <meta property="og:title" content={`${title} — UC Davis Robotics Club`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — UC Davis Robotics Club`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} — UC Davis Robotics Club</title>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <div class="site-gears" aria-hidden="true">
      <div class="gear-rail gear-rail-left">
        <img class="gear gear-left-large" src={`${base}images/Gear.png`} alt="" />
        <img class="gear gear-left-small" src={`${base}images/Gear.png`} alt="" />
        <img class="gear gear-left-middle" src={`${base}images/Gear.png`} alt="" />
      </div>
      <div class="gear-rail gear-rail-right">
        <img class="gear gear-right-small" src={`${base}images/Gear.png`} alt="" />
        <img class="gear gear-right-large" src={`${base}images/Gear.png`} alt="" />
        <img class="gear gear-right-middle" src={`${base}images/Gear.png`} alt="" />
      </div>
    </div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const gearRails = document.querySelectorAll<HTMLElement>('.gear-rail');

      gearRails.forEach(rail => {
        const isLeftRail = rail.classList.contains('gear-rail-left');
        const topZones = isLeftRail
          ? [[2, 20], [36, 56], [72, 90]]
          : [[16, 34], [52, 72], [82, 98]];

        rail.querySelectorAll<HTMLElement>('.gear').forEach((gear, index) => {
          const [minTop, maxTop] = topZones[index];
          const top = minTop + Math.random() * (maxTop - minTop);
          const edgeOffset = -12 + Math.random() * 18;
          const scale = 0.5 + Math.random() * 2;
          gear.style.top = `${top}%`;
          gear.style.setProperty('--gear-edge-offset', `${edgeOffset}rem`);
          gear.style.setProperty('--gear-scale', scale.toFixed(2));
        });
      });
    </script>
  </body>
</html>
