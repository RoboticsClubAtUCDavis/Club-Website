---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

// Template:   { src: `${base}images/`, alt: '', category: ['Category', 'Another Category'], size: '' },
// List of categories (manually updated): Meetings, Combat Robotics, Events, CAD, Drone, Line Follower, Quadruped

const photos = [
  { src: `${base}images/Combat%20Robotics/02D83855747A3AA3DD194A3B6D85FD95.png`, alt: '2025 Member Purple Plastic 1lb Antweight 1', category: 'Combat Robotics', size: 'large' },
  { src: `${base}images/Combat%20Robotics/CAD84AA3-8542-4606-A5DC-B878B2DB9862.jpg`, alt: '2023 1lb Pink/Black Antweight', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/B9E49CEA-55FB-427F-B580-94D13033A84E.jpg`, alt: '2023 Blue Plastic Antweight', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/IMG_0556.jpg`, alt: 'Antweight Electronics Wiring', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/2E6CA53948386972C3F1978441B3E75A.png`, alt: '2025 Member Purple Plastic 1lb Antweight 2', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/DB755629-E323-4910-8573-251C83CFBD44.jpg`, alt: '2023 1lb Pink/Black Antweight', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/IMG_0648.jpg`, alt: 'Fall 2025 White Plastic Antweight Post-Fight', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/IMG_0677.jpg`, alt: 'Fall 2025 White Plastic Antweight 1', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/IMG_0759.jpg`, alt: 'Fall 2025 Purple Plastic Antweight 1', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/IMG_0760.jpg`, alt: 'Fall 2025 Purple Plastic Antweight 2', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/IMG_0761.jpg`, alt: 'Fall 2025 Purple Plastic Antweight 3', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/IMG_0763.jpg`, alt: 'Fall 2025 Purple Plastic Antweight 4', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Drone/image.png`, alt: '2025 Picnic Day Table 1', category: ['Drone', 'Events'], size: 'large' },
  { src: `${base}images/Drone/aerial.png`, alt: '2025 Picnic Day Aerial Drone Capture', category: ['Drone', 'Events'], size: 'small' },
  { src: `${base}images/Drone/68792591330__7A4233E5-0C54-4E37-BDD2-CDBA8CFBEF5E_Original.png`, alt: '2025 Project Showcase Prep For Picnic Day', category: ['Drone', 'Events'], size: 'small' },
  { src: `${base}images/Drone/IMG_3854_Original.png`, alt: '2025 Picnic Day Table 2', category: ['Drone', 'Events'], size: 'small' },
  { src: `${base}images/Mini%20bot/IMG_0396.png`, alt: 'Winter 2025 Line Follower 1', category: 'Line Follower', size: 'large' },
  { src: `${base}images/Mini%20bot/IMG_0393.png`, alt: 'Winter 2025 Line Follower Code Review', category: 'Line Follower', size: 'small' },
  { src: `${base}images/Mini%20bot/IMG_0394.png`, alt: 'Winter 2025 Line Follower Test Run', category: 'Line Follower', size: 'small' },
  { src: `${base}images/Mini%20bot/IMG_0397.png`, alt: 'Winter 2025 Line Follower 2', category: 'Line Follower', size: 'small' },
  { src: `${base}images/Mini%20bot/20250222_171231.png`, alt: 'Winter 2025 Line Follower 3', category: 'Line Follower', size: 'small' },
  { src: `${base}images/Quadruped/image.png`, alt: 'Quadruped Robot Prototype', category: 'Quadruped', size: 'small' },
  { src: `${base}images/Past_Meeting.png`, alt: 'Past Club Meeting', category: 'Meetings', size: 'small' },
  { src: `${base}images/October_2025_Meeting.jpg`, alt: 'Fall 2025 First Club Meeting', category: 'Meetings', size: 'small' },
  { src: `${base}images/2025%20Engineering%20Club%20Day/IMG_0448.png`, alt: 'Spring 2025 Yellow Plastic Antweight 1', category: 'Combat Robotics', size: 'large' },
  { src: `${base}images/2025%20Engineering%20Club%20Day/WhiteBot.png`, alt: 'Fall 2025 White Plastic Antweight 2', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/2025%20Engineering%20Club%20Day/YellowBot.png`, alt: 'Spring 2025 Yellow Plastic Antweight 2', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/2025%20Engineering%20Club%20Day/20250513_191503.png`, alt: 'Spring 2025 Yellow Plastic Antweight 3', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/2025%20Engineering%20Club%20Day/20250513_192712.png`, alt: 'Spring 2025 Yellow Plastic Antweight 4', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/2025%20Engineering%20Club%20Day/IMG_0446.png`, alt: 'Spring 2025 Yellow Plastic Antweight 5', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/2025%20Engineering%20Club%20Day/IMG_0447.png`, alt: 'Spring 2025 Yellow Plastic Antweight 6', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/2023_member_1lb_wedge_prototype.png`, alt: '2023 Member 1lb Wedge Prototype', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Meetings/First_Meeting_Front_Oct_2026.jpg`, alt: 'Fall 2026 First Club Meeting', category: 'Meetings', size: 'small' },
  { src: `${base}images/Meetings/First_Meeting_Back_Oct_2026.jpg`, alt: 'Fall 2026 First Club Meeting', category: 'Meetings', size: 'large' },
  { src: `${base}images/Combat%20Robotics/Jeff_Antweight_2026.jpg`, alt: 'Fall 2026 "Jeff" Antweight', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Combat%20Robotics/Patty_Antweight_2026.jpg`, alt: 'Fall 2026 "Patty" Antweight', category: 'Combat Robotics', size: 'small' },
  { src: `${base}images/Events/Orientation_Engineering_Club_Fair_1.jpg`, alt: 'Fall 2026 Orientation Club Fair', category: 'Events', size: 'large' },
  { src: `${base}images/Events/Orientation_Engineering_Club_Fair_2.jpg`, alt: 'Fall 2026 Orientation Club Fair', category: 'Events', size: 'small' },
  { src: `${base}images/Events/Orientation_Engineering_Club_Fair_3.jpg`, alt: 'Fall 2026 Orientation Club Fair', category: 'Events', size: 'small' },
  { src: `${base}images/Events/Orientation_Engineering_Club_Fair_4.jpg`, alt: 'Fall 2026 Orientation Club Fair', category: 'Events', size: 'small' },
  { src: `${base}images/Combat%20Robotics/Patty_CAD_Colored.png`, alt: 'Fall 2026 CAD of "Patty" Antweight', category: ['CAD', 'Combat Robotics'], size: 'small' },


];

// Sort photos by year and season in alt, with key words like "Picnic Day" considered Spring

const getPhotoDate = (alt: string) => {
  const year = Number(alt.match(/\b20\d{2}\b/)?.[0] ?? 0);
  const season = alt.match(/\b(winter|spring|summer|fall)\b/i)?.[0].toLowerCase();
  const seasonOrder: Record<string, number> = { winter: 1, spring: 2, summer: 3, fall: 4 };
  const periodOrder = season ? seasonOrder[season] : /\bpicnic day\b/i.test(alt) ? 2 : 3;
  return year * 10 + periodOrder;
};

const newestPhotos = [...photos].sort((first, second) => getPhotoDate(second.alt) - getPhotoDate(first.alt));
const getCategories = (category: string | string[]) => Array.isArray(category) ? category : [category];
const categories = ['All', ...new Set(newestPhotos.flatMap(p => getCategories(p.category)))];
---

<Layout title="Gallery" description="Photos from UC Davis Robotics Club — lab work, competitions, and workshops.">

  <section class="page-hero section gallery-hero" style="border-bottom:none;">
    <div class="container">
      <p class="section-label">In pictures</p>
      <h1 class="section-title" style="font-size:clamp(2.5rem,5vw,4rem);">Gallery</h1>
      <p class="section-body">A look at what goes on in the lab, at competitions, and in the community.</p>
    </div>
  </section>

  <section class="section gallery-content">
    <div class="container">

      <!-- Category filter -->
      <div class="filter-bar" id="filterBar">
        {categories.map(c => (
          <button class:list={['filter-btn', c === 'All' ? 'active' : '']} data-cat={c}>
            {c}
          </button>
        ))}
      </div>

      <!-- Organized gallery grid -->
      <div class="gallery-grid" id="galleryGrid">
        {newestPhotos.map(p => (
          <button class="gallery-item" data-cat={getCategories(p.category).join('|')} data-size={p.size} type="button" aria-label={`Expand image: ${p.alt}`}>
            <img src={p.src} alt={p.alt} class="gallery-img" loading="lazy" decoding="async" />
            <div class="gallery-overlay">
              <p class="gallery-caption">{p.alt}</p>
              {getCategories(p.category).map(category => <span class="gallery-cat">{category}</span>)}
            </div>
          </button>
        ))}
      </div>

    </div>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Expanded gallery image">
    <div class="lightbox-content">
      <button class="lightbox-close" id="lightboxClose" type="button" aria-label="Close expanded image">&times;</button>
      <button class="lightbox-arrow lightbox-prev" id="lightboxPrev" type="button" aria-label="Previous image">&#8249;</button>
      <img class="lightbox-img" id="lightboxImg" alt="" />
      <button class="lightbox-arrow lightbox-next" id="lightboxNext" type="button" aria-label="Next image">&#8250;</button>
      <p class="lightbox-caption" id="lightboxCaption"></p>
    </div>
  </dialog>

  <!-- Submit photo CTA -->
  <section class="section" style="background:var(--surface-2);border-top:1px solid var(--border);">
    <div class="container" style="max-width:580px; text-align:center; margin-inline:auto;">
      <p class="section-label">Contribute</p>
      <h2 class="section-title" style="font-size:2rem;">Got a photo to share?</h2>
      <p class="section-body" style="margin-inline:auto; margin-bottom:2rem;">
        If you attended an event or captured something cool in the lab, send it our way.
      </p>
      <a href="https://forms.gle/ywqMth8pzfQKZ42E8" class="btn btn-outline">Submit a Photo</a>
    </div>
  </section>

</Layout>

<style>
.gallery-hero { padding-bottom: 24px; }
.gallery-content { padding-top: 48px; }

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 2.5rem;
}

.filter-btn {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.4em 1em;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.15s;
}

.filter-btn:hover, .filter-btn.active {
  background: var(--gold);
  color: #000;
  border-color: var(--gold);
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  grid-auto-rows: 200px;
  grid-auto-flow: dense;
  gap: 12px;
}

.gallery-item {
  appearance: none;
  border: 0;
  padding: 0;
  font: inherit;
  color: inherit;
  background: none;
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  border-radius: 6px;
  cursor: pointer;
  text-align: left;
}

.gallery-item:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

.gallery-item:hover .gallery-img,
.gallery-item:focus-visible .gallery-img { transform: scale(1.03); }

.gallery-item[data-size="large"] { grid-column: span 2; grid-row: span 2; }

.gallery-img {
  width: 100%;
  height: 100%;
  border-radius: 6px;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.gallery-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 60%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1rem;
  opacity: 0;
  transition: opacity 0.2s;
}

.gallery-item:hover .gallery-overlay,
.gallery-item:focus-visible .gallery-overlay { opacity: 1; }

.gallery-caption {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 600;
  color: #fff;
  margin-bottom: 0.25rem;
}

.gallery-cat {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold);
}

/* hidden by filter */
.gallery-item.hidden { display: none; }

.lightbox {
  width: 100%;
  height: 100%;
  max-width: none;
  max-height: none;
  padding: 2rem 5rem;
  border: 0;
  background: rgba(8, 9, 10, 0.94);
  color: var(--text);
}

.lightbox::backdrop { background: rgba(8, 9, 10, 0.88); }

.lightbox-content {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lightbox-img {
  max-width: min(100%, 1100px);
  max-height: calc(100vh - 7rem);
  width: auto;
  height: auto;
  object-fit: contain;
}

.lightbox-close,
.lightbox-arrow {
  position: absolute;
  z-index: 1;
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: #fff;
  background: rgba(0, 0, 0, 0.38);
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
}

.lightbox-close:hover,
.lightbox-arrow:hover,
.lightbox-close:focus-visible,
.lightbox-arrow:focus-visible {
  background: rgba(201, 168, 76, 0.8);
  border-color: var(--gold);
  color: #000;
}

.lightbox-close {
  top: 0;
  right: 0;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  font-size: 1.75rem;
  line-height: 1;
}

.lightbox-arrow {
  top: 50%;
  width: 3.25rem;
  height: 5rem;
  transform: translateY(-50%);
  border-radius: 4px;
  font-size: 3rem;
  font-family: var(--font-display);
  font-weight: 400;
  line-height: 1;
}

.lightbox-prev { left: 0; }
.lightbox-next { right: 0; }

.lightbox-caption {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: min(100%, 700px);
  color: var(--text-muted);
  font-family: var(--font-mono);
  text-align: center;
  font-size: 0.85rem;
}

@media (max-width: 600px) {
  .lightbox { padding: 3.5rem 0.75rem; }
  .lightbox-arrow { width: 2.5rem; height: 4rem; font-size: 2.25rem; }
  .lightbox-img { max-height: calc(100vh - 9rem); }
}

@media (max-width: 860px) {
  .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 500px) {
  .gallery-grid { grid-template-columns: 1fr; grid-auto-rows: 220px; }
  .gallery-item[data-size="large"] { grid-column: span 1; grid-row: span 1; }
}
</style>

<script>
const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
const items = document.querySelectorAll<HTMLButtonElement>('.gallery-item');
const lightbox = document.querySelector<HTMLDialogElement>('#lightbox');
const lightboxImg = document.querySelector<HTMLImageElement>('#lightboxImg');
const lightboxCaption = document.querySelector<HTMLParagraphElement>('#lightboxCaption');
const lightboxClose = document.querySelector<HTMLButtonElement>('#lightboxClose');
const lightboxPrev = document.querySelector<HTMLButtonElement>('#lightboxPrev');
const lightboxNext = document.querySelector<HTMLButtonElement>('#lightboxNext');
let currentIndex = 0;

const visibleItems = () => Array.from(items).filter(item => !item.classList.contains('hidden'));

const showImage = (index: number) => {
  const currentItems = visibleItems();
  currentIndex = (index + currentItems.length) % currentItems.length;
  const image = currentItems[currentIndex].querySelector<HTMLImageElement>('.gallery-img');
  if (!image || !lightboxImg || !lightboxCaption) return;
  lightboxImg.src = image.src;
  lightboxImg.alt = image.alt;
  lightboxCaption.textContent = image.alt;
};

const openLightbox = (item: HTMLButtonElement) => {
  const index = visibleItems().indexOf(item);
  showImage(index);
  lightbox?.showModal();
};

items.forEach(item => item.addEventListener('click', () => openLightbox(item)));
lightboxClose?.addEventListener('click', () => lightbox?.close());
lightboxPrev?.addEventListener('click', () => showImage(currentIndex - 1));
lightboxNext?.addEventListener('click', () => showImage(currentIndex + 1));
lightbox?.addEventListener('click', event => {
  if (event.target === lightbox) lightbox.close();
});

document.addEventListener('keydown', event => {
  if (!lightbox?.open) return;
  if (event.key === 'ArrowLeft') showImage(currentIndex - 1);
  if (event.key === 'ArrowRight') showImage(currentIndex + 1);
});

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const cat = btn.dataset.cat;
    items.forEach(item => {
      item.classList.toggle('hidden', cat !== 'All' && !item.dataset.cat?.split('|').includes(cat ?? ''));
    });
  });
});
</script>
