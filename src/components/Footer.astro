---
const base = import.meta.env.BASE_URL;
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-brand-content">
        <img
          class="footer-logo"
          src={`${base}images/Logos/Robot_Arm_Logo.png`}
          alt="Davis Robotics Club logo"
          loading="lazy"
          decoding="async"
        />
        <div class="footer-brand-text">
          <p class="footer-name">Davis Robotics Club</p>
          <p class="footer-sub">University of California, Davis</p>
        </div>
      </div>
    </div>

    <nav class="footer-nav">
      <div class="footer-col">
        <p class="footer-col-title">Club</p>
        <a href={`${base}about`}>About</a>
        <a href={`${base}team`}>Team</a>
        <a href={`${base}join`}>Join Us</a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">Work</p>
        <a href={`${base}projects`}>Projects</a>
        <a href={`${base}events`}>Events</a>
        <a href={`${base}gallery`}>Gallery</a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">Connect</p>
        <a href={`${base}contact`}>Contact</a>
        <a href="https://discord.gg/XA3rYvC9A9" target="_blank" rel="noopener">Discord</a>
        <a href="https://www.instagram.com/davisrobotics/" target="_blank" rel="noopener">Instagram</a>
      </div>
    </nav>
  </div>

  <div class="container footer-bottom">
    <div class="footer-contact">
      <p>General Meeting times TBD for upcoming Fall 2026.</p>
    </div>
    <p>(c) {new Date().getFullYear()} Davis Robotics Club. All rights reserved.</p>
    <p>Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
  </div>
</footer>

<style>
.footer {
  border-top: 1px solid var(--border);
  margin-top: auto;
  padding-top: 3rem;
  padding-bottom: 2rem;
}

.footer-inner {
  display: flex;
  gap: 4rem;
  flex-wrap: wrap;
  padding-bottom: 2.5rem;
  border-bottom: 1px solid var(--border);
}

.footer-brand {
  flex: 1;
  min-width: 180px;
}

.footer-brand-content {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.footer-logo {
  width: 9.2rem;
  height: auto;
  flex-shrink: 0;
  object-fit: contain;
  opacity: 0;
  transform: translateX(-140%) rotate(-360deg);
}

.footer-logo.is-visible {
  animation: footer-logo-roll 1.1s cubic-bezier(0.22, 0.8, 0.28, 1) forwards;
}

@keyframes footer-logo-roll {
  from {
    opacity: 0;
    transform: translateX(-140%) rotate(-360deg);
  }
  to {
    opacity: 1;
    transform: translateX(0) rotate(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .footer-logo,
  .footer-logo.is-visible {
    opacity: 1;
    transform: none;
    animation: none;
  }
}

.footer-brand-text {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.footer-name {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.25rem, 1.3vw, 1.8rem);
  line-height: 1.1;
  color: var(--text);
  margin: 0;
}

.footer-sub {
  font-size: clamp(0.8rem, 0.9vw, 1rem);
  line-height: 1.35;
  color: var(--text-dim);
  margin: 0;
}

.footer-nav {
  display: flex;
  gap: 3rem;
  flex-wrap: wrap;
}

.footer-col {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.footer-col-title {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.25rem;
}

.footer-col a {
  font-size: 0.875rem;
  color: var(--text-muted);
  transition: color 0.15s;
}
.footer-col a:hover { color: var(--text); }

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 1rem;
  padding-top: 1.5rem;
  font-size: 0.78rem;
  color: var(--text-dim);
}

.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: min(100%, 300px);
}

.footer-bottom a { color: var(--gold); }
.footer-bottom a:hover { color: var(--text); }
</style>

<script>
const footerLogo = document.querySelector<HTMLElement>('.footer-logo');

if (footerLogo) {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    footerLogo.classList.add('is-visible');
  } else {
    const logoObserver = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        footerLogo.classList.remove('is-visible');
        void footerLogo.offsetWidth;
        footerLogo.classList.add('is-visible');
      } else {
        footerLogo.classList.remove('is-visible');
      }
    }, { threshold: 0.35 });

    logoObserver.observe(footerLogo);
  }
}
</script>
