--- // Opening boundary for javascript/typescript
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

/*
Notes
1. Events are sorted by date, so make sure to add new events in the correct order. Older events are on the top of the list and will be moved to the past events section once they have passed.
2. To add another event, you can use the following template:
  {
    title: '[Insert Event Title]',
    date: '[Weekday], [Abbreviated Month] [Day]',
    time: '##:##am-##:##pm',
    endAt: 'YYYY-MM-DDTHH:MM:SS-07:00' (PDT) or 'YYYY-MM-DDTHH:MM:SS-08:00' (PST),
    location: 'Location',
    mapUrl: 'Google Maps URL',
    tag: 'Tag',
    desc: "Description", (Use double quotes if you want to include apostrophes in the text)
    linkText: 'Text for the link', (Optional)
    linkUrl: 'URL for the link', (Optional)
  },
*/


