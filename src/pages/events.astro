--- // Closing boundary for javascript/typescript

<Layout title="Events" description="Future events and past workshops from UC Davis Robotics Club.">
  <section class="page-hero section events-page-hero">
    <div class="container">
      <div class="events-banner" aria-label="Photos from the Engineering Club Fair">
        <div class="events-banner-track" data-event-banner-track>
          {[...eventBannerImages, ...eventBannerImages].map((image, index) => (
            <img
              src={image.src}
              alt={image.alt}
              data-event-banner-image
              data-slide-index={index}
            />
          ))}
        </div>
      </div>
      <p class="section-label">Schedule</p>
      <h1 class="section-title" style="font-size:clamp(2.5rem,5vw,4rem);">Upcoming Events</h1>
      <p class="section-body">
        Future club meetings, workshops, and project sessions. Check back for confirmed
        dates and room numbers as they are announced.
      </p>
      <div class="event-list" data-upcoming-events>
        {futureEvents.map(event => (
          <article class="event-row" data-event-row data-end-time={event.endAt}>
            <div class="event-date-col">
              <p class="event-date">{event.date}</p>
              <p class="event-time">{event.time}</p>
            </div>
            <div class="event-info">
              <h3 class="event-title">{event.title}</h3>
              {event.mapUrl ? (
                <a class="event-location" href={event.mapUrl} target="_blank" rel="noopener noreferrer">
                  {event.location}
                </a>
              ) : (
                <p class="event-location">{event.location}</p>
              )}
              <p class="event-desc">
                {event.desc}
                {event.linkUrl && (
                  <>
                    {' '}
                    <a class="event-desc-link" href={event.linkUrl} target="_blank" rel="noopener noreferrer">
                      {event.linkText || 'Learn more'}
                    </a>
                  </>
                )}
              </p>
            </div>
            <span class="event-badge" data-tag={event.tag.toLowerCase()}>{event.tag}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section events-band">
    <div class="container">
      <p class="section-label">Archive</p>
      <h2 class="section-title">Recent Events</h2>
      <div class="event-list" data-past-events>
        <p class="past-empty" data-past-empty>No past events yet.</p>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--surface-2); border-block:1px solid var(--border);">
    <div class="container events-cta">
      <p class="section-label">Stay updated</p>
      <h2 class="section-title" style="font-size:2rem;">Want event announcements?</h2>
      <p class="section-body">
        Join the club Discord or contact the team for the latest meeting times and event details.
      </p>
      <div class="cta-actions">
        <a href="https://discord.gg/XA3rYvC9A9" target="_blank" rel="noopener" class="btn btn-primary">Join Discord</a>
        <a href={`${base}join`} class="btn btn-outline">Join Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
.event-list {
  display: flex;
  flex-direction: column;
  margin-top: 2.5rem;
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
}

.events-banner {
  position: relative;
  width: min(100%, 760px);
  aspect-ratio: 4 / 3;
  margin: 0 auto 2rem;
  overflow: hidden;
  border-radius: 8px;
  background: var(--surface);
}

.events-page-hero {
  padding-top: calc(var(--nav-h) + 24px);
}

.events-banner-track {
  display: flex;
  width: 100%;
  height: 100%;
  transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.25, 1);
}

.events-banner img {
  flex: 0 0 100%;
  display: block;
  min-width: 0;
  height: 100%;
  object-fit: contain;
  opacity: 1;
}

.event-row {
  display: grid;
  grid-template-columns: 180px 1fr auto;
  align-items: center;
  gap: 1.5rem;
  padding: 1.4rem 1.75rem;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  transition: background 0.15s, transform 0.2s ease;
}

.event-date-col,
.event-info,
.event-badge {
  opacity: 0;
  transform: translateY(70px);
}

.event-row.is-visible .event-date-col,
.event-row.is-visible .event-info,
.event-row.is-visible .event-badge {
  animation: event-row-fly-in 0.65s cubic-bezier(0.2, 0.8, 0.25, 1) forwards;
}

.event-row:nth-child(2) .event-date-col,
.event-row:nth-child(2) .event-info,
.event-row:nth-child(2) .event-badge { animation-delay: 0.12s; }
.event-row:nth-child(3) .event-date-col,
.event-row:nth-child(3) .event-info,
.event-row:nth-child(3) .event-badge { animation-delay: 0.24s; }
.event-row:nth-child(4) .event-date-col,
.event-row:nth-child(4) .event-info,
.event-row:nth-child(4) .event-badge { animation-delay: 0.36s; }
.event-row:nth-child(5) .event-date-col,
.event-row:nth-child(5) .event-info,
.event-row:nth-child(5) .event-badge { animation-delay: 0.48s; }

@keyframes event-row-fly-in {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.event-row:last-child { border-bottom: none; }
.event-row:hover {
  background: var(--surface-2);
  transform: scale(1.02);
  position: relative;
  z-index: 1;
}

.event-date {
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text);
}

.event-time {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--text-muted);
  margin-top: 0.25rem;
}

.event-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 0.3rem;
}

.event-info {
  min-width: 0;
}

.event-location {
  display: inline-block;
  color: var(--text-muted);
  font-size: 0.8rem;
  text-decoration: underline;
  text-underline-offset: 0.15rem;
}

.event-location:hover {
  color: var(--gold);
}

.event-desc {
  color: var(--text-muted);
  font-size: 0.8rem;
  line-height: 1.5;
  margin-top: 0.35rem;
  max-width: 52ch;
}

.event-desc-link {
  color: var(--gold);
  text-decoration: underline;
  text-underline-offset: 0.15rem;
}

.event-desc-link:hover {
  color: #e0bc60;
}

.event-badge {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.25em 0.75em;
  border-radius: 999px;
  white-space: nowrap;
  background: rgba(201,168,76,0.1);
  color: var(--gold);
  border: 1px solid rgba(201,168,76,0.25);
}

.event-badge[data-tag='competition'] {
  background: rgba(220, 38, 38, 0.12);
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.3);
}

.event-badge[data-tag='school events'] {
  background: rgba(37, 99, 235, 0.12);
  color: #3b82f6;
  border-color: rgba(59, 130, 246, 0.3);
}

.event-badge[data-tag='meeting'] {
  background: rgba(22, 163, 74, 0.12);
  color: #22c55e;
  border-color: rgba(34, 197, 94, 0.3);
}

.event-badge[data-tag='community events'] {
  background: rgba(163, 118, 22, 0.12);
  color: #e69927;
  border-color: rgba(197, 132, 34, 0.3);
}

.events-band {
  background: var(--surface);
  border-block: 1px solid var(--border);
}

.past-empty {
  padding: 1.4rem 1.75rem;
  color: var(--text-muted);
  font-size: 0.85rem;
}

.events-cta {
  max-width: 680px;
}

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}

@media (max-width: 650px) {
  .event-row {
    grid-template-columns: 1fr;
  }

  .event-date-col {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .event-badge {
    width: fit-content;
  }

}

@media (prefers-reduced-motion: reduce) {
  .events-banner-track,
  .events-banner img {
    transition: none;
  }


  .event-date-col,
  .event-info,
  .event-badge {
    opacity: 1;
    transform: none;
    animation: none;
  }
}
</style>

<script>
  const bannerTrack = document.querySelector<HTMLElement>('[data-event-banner-track]');
  const bannerImages = bannerTrack
    ? Array.from(bannerTrack.querySelectorAll<HTMLElement>('[data-event-banner-image]'))
    : [];
  const bannerImageCount = bannerImages.length / 2;
  let bannerPosition = 0;

  const updateBanner = (animate = true) => {
    if (!bannerTrack || bannerImages.length === 0) return;

    const imageWidth = bannerImages[0].getBoundingClientRect().width;
    const gap = parseFloat(getComputedStyle(bannerTrack).gap) || 0;
    bannerTrack.style.transition = animate ? '' : 'none';
    bannerTrack.style.transform = `translateX(-${bannerPosition * (imageWidth + gap)}px)`;
    bannerImages.forEach((image, index) => {
      image.classList.toggle('is-focal', index === bannerPosition);
    });
  };

  updateBanner(false);

  if (bannerTrack && bannerImages.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.setInterval(() => {
      bannerPosition += 1;
      updateBanner();

      if (bannerPosition === bannerImageCount) {
        window.setTimeout(() => {
          bannerPosition = 0;
          updateBanner(false);
        }, 750);
      }
    }, 5000);
  }

  window.addEventListener('resize', () => updateBanner(false));

  const upcomingEvents = document.querySelector<HTMLElement>('[data-upcoming-events]');
  const pastEvents = document.querySelector<HTMLElement>('[data-past-events]');
  const pastEmpty = document.querySelector<HTMLElement>('[data-past-empty]');

  const movePastEvents = () => {
    if (!upcomingEvents || !pastEvents || !pastEmpty) return;

    upcomingEvents.querySelectorAll<HTMLElement>('[data-event-row]').forEach(row => {
      const endTime = row.dataset.endTime;
      if (endTime && new Date(endTime).getTime() <= Date.now()) {
        pastEvents.appendChild(row);
      }
    });

    pastEmpty.hidden = pastEvents.querySelector('[data-event-row]') !== null;
  };

  movePastEvents();

  const eventRows = document.querySelectorAll<HTMLElement>('[data-event-row]');

  if (eventRows.length) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      eventRows.forEach(row => row.classList.add('is-visible'));
    } else {
      const eventObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            eventRows.forEach(row => row.classList.add('is-visible'));
            eventObserver.disconnect();
          }
        });
      }, { threshold: 0.1 });

      eventRows.forEach(row => eventObserver.observe(row));
    }
  }

  const nextEventEnd = Array.from(document.querySelectorAll<HTMLElement>('[data-event-row]'))
    .map(row => row.dataset.endTime ? new Date(row.dataset.endTime).getTime() : Infinity)
    .filter(endTime => endTime > Date.now())
    .sort((first, second) => first - second)[0];

  if (nextEventEnd) {
    window.setTimeout(() => window.location.reload(), nextEventEnd - Date.now() + 100);
  }
</script>
