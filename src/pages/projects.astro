---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const projects = [
  {
    title: 'Combat Robotics',
    tag: 'Combat · Hardware',
    status: 'Active',
    year: '2026-2027',
    desc: 'We design, 3D print, and battle custom 1-lb and 3-lb combat robots in our own arena—and face off against rival universities in collegiate throwdowns! From building custom flippers like Patty to dialing in drivetrains and armor, this subteam is all about designing for combat with strength and durability as the focus.',
    tech: ['3D Printing', 'CAD', 'Rapid Prototyping', 'LiPo Power', 'Arena Fabrication'],
    image: `${base}images/Combat%20Robotics/Patty_Antweight_2026.jpg`,
  },

  {
    title: 'Precision Robotic Arm',
    tag: 'Manipulator · Robotics',
    status: 'Active',
    year: '2026-2027',
    desc: 'Bringing industrial manufacturing to the club workbench. We are engineering a multi-axis robotic arm from scratch, complete with custom 3D-printed gearboxes, in-house motor control PCBs designed in KiCad, and smooth inverse kinematics math to give it smooth, precise coordinate control.',
    tech: ['Fusion 360', 'KiCad PCB', 'ESP32 / Arduino', 'Inverse Kinematics', 'Gearbox Design'],
    image: `${base}images/Placeholders/WIP_Robot_Arm.png`,
  },

  {
    title: 'Drones & Planes',
    tag: 'Aerospace · Flight Systems',
    status: 'Active',
    year: '2026-2027',
    desc: 'Everything built to take to the skies! We construct acrobatic FPV quadcopters and custom fixed-wing RC planes from the ground up, outfitting them with high-power brushless setups, telemetry, and ArduPilot flight controllers for rock-solid stabilization and GPS route navigation.',
    tech: ['ArduPilot', 'Flight Controllers', 'Telemetry', 'ESC & Brushless Motors', 'Aerodynamics'],
    image: `${base}images/Placeholders/WIP_Plane_Drone.png`,
  },

  {
    title: 'Hub-Motor RC Car',
    tag: 'Electric Vehicle · Drivetrain',
    status: 'Active',
    year: '2026-2027',
    desc: 'Ditching heavy gears and drivetrains for raw, instantaneous power. We are building a custom high-performance electric RC chassis using direct-drive brushless hub motors packed right into the wheels, paired with double-wishbone suspension, custom steering geometry, and per-wheel torque vectoring.',
    tech: ['Direct-Drive Hubs', 'Vehicle Dynamics', 'Ackerman Steering', 'Suspension CAD', 'Individual ESCs'],
    image: `${base}images/Placeholders/WIP_RC_Car.png`,
  },
  {
    title: '3D Printer Modifications',
    tag: 'Additive · Motion Systems',
    status: 'Active',
    year: '2026-2027',
    desc: 'Pushing desktop 3D printers past their factory limits! We are transforming an old printer into a faster modern counterpart. Adding things like a 100W hotend, Raspberry Pi host boards running Klipper, and resonance-canceling accelerometers for fast prints.',
    tech: ['CoreXY Kinematics', 'Klipper Firmware', 'Raspberry Pi', 'Input Shaping (ADXL345)', 'Thermal PID Tuning'],
    image: `${base}images/Placeholders/WIP_3D_Printer.png`,
  },
  {
    title: 'VEX U — Override',
    tag: 'Collegiate Competition · Robotics',
    status: 'Active',
    year: '2026-2027',
    desc: "Our collegiate competition taking on this season's game, Override! We are building two unique robots that work in tandem: a fast, compact 15-inch bot to weave through traffic and run quick cycles, and a powerhouse 24-inch robot built for huge scoring capacity, reliable lifts, and dialed-in driver control.",
    tech: ['VEX V5 Architecture', 'Dual-Robot Strategy', 'Path Planning', 'Motion Profiling', 'Drive Kinematics'],
    image: `${base}images/Placeholders/WIP_Vex.png`,
  },
  {
    title: 'ARLISS Rover Competition',
    tag: 'Aerospace · Rover Robotics',
    status: 'Active',
    year: '2026-2027',
    desc: 'A high-flying joint mission with the National Association of Rocketry at UC Davis. We are designing a rugged CanSat rover that will be launched thousands of feet into the sky on a high-power rocket, survives a violent 50G parachute touchdown, and traverses rough desert terrain straight to its GPS coordinates.',
    tech: ['GNSS / GPS Waypointing', 'High-G Shock Packaging', 'CanSat Airframes', 'Telemetry', 'Ground Traversing'],
    image: `${base}images/Placeholders/WIP_ARLISS.png`,
  },

  {
    title: 'Drone Platform - Picnic Day',
    tag: 'Aerial · Autonomy',
    status: 'Archived',
    year: '2025',
    desc: "A custom aerial platform for flight testing, visual sensing, and autonomous navigation experiments presented at UC Davis's Picnic Day. The project focuses on reliable hardware integration and flight stability.",
    tech: ['ROS2', 'Computer Vision', 'Python', 'Flight Control'],
    image: `${base}images/Drone/image.png`,
  },
  {
    title: 'Mini Bot Line Follower',
    tag: 'Beginner · Controls',
    status: 'Archived',
    year: '2025',
    desc: 'A beginner-friendly line-following robot used to teach sensor calibration, control loops, and embedded programming in a compact build.',
    tech: ['Arduino', 'PID', 'IR Sensors', 'C++'],
    image: `${base}images/Mini%20bot/IMG_0396.png`,
  },
  {
    title: 'Quadruped Robot',
    tag: 'Legged Locomotion',
    status: 'Archived',
    year: '2025',
    desc: 'A compact quadruped platform exploring gait control, balance, and legged locomotion. The build is focused on making complex motion systems approachable for student teams.',
    tech: ['Embedded C++', 'IMU', 'Servo Motors', 'Control Theory'],
    image: `${base}images/Quadruped/image.png`,
  },
    {
    title: 'Engineering Club Day Showcase',
    tag: 'Outreach · Demo',
    status: 'Archived',
    year: '2025',
    desc: 'A hands-on robotics showcase built for Engineering Club Day, featuring interactive bots and demonstrations that introduce students to mechanical, electrical, and software systems.',
    tech: ['Rapid Prototyping', 'Embedded Systems', 'Outreach', 'CAD'],
    image: `${base}images/2025%20Engineering%20Club%20Day/IMG_0448.png`,
  },
];

const activeProjects = projects.filter(project => project.status !== 'Archived');
const archivedProjects = projects.filter(project => project.status === 'Archived');
---

<Layout title="Projects" description="Explore robotics projects built by UC Davis Robotics Club members.">

  <section class="page-hero section projects-hero" style="border-bottom:none;">
    <div class="container">
      <p class="section-label">What we build</p>
      <h1 class="section-title" style="font-size:clamp(2.5rem,5vw,4rem);">Our Projects</h1>
      <p class="section-body">
        From combat robots to drones — every project is designed, built,
        and tested by students at Davis.
      </p>
      <aside class="member-project-banner" aria-labelledby="member-project-title">
        <div>
          <p class="section-label">Member feature</p>
          <h2 id="member-project-title">Give your project a page of its own</h2>
          <p>
            Members can be featured on the club website with a page about who they are and a project they built through the club.
          </p>
        </div>
        <a href={`${base}team#contact`} class="btn btn-outline">Ask about being featured</a>
      </aside>
    </div>
  </section>

  <section class="section projects-content">
    <div class="container">
      <div class="projects-list">
        {activeProjects.map(p => (
          <article class="project-row">
            <div class="project-img-wrap">
              <img src={p.image} alt={p.title} class="project-img" loading="lazy" decoding="async" />
            </div>
            <div class="project-detail">
              <div class="project-meta">
                <span class="project-tag-text">{p.tag}</span>
                <span class:list={['project-status', p.status === 'Active' ? 'status-active' : p.status === 'Design Phase' ? 'status-plan' : 'status-done']}>
                  {p.status}
                </span>
              </div>
              <h3 class="proj-title">{p.title}</h3>
              <p class="proj-desc">{p.desc}</p>
              <div class="tech-stack">
                {p.tech.map(t => <span class="tech-tag">{t}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section project-slides" aria-labelledby="project-slides-title">
    <div class="container">
      <p class="section-label">Explore the projects</p>
      <h2 class="section-title" id="project-slides-title">Project Overview</h2>
      <div class="project-slides-frame">
        <iframe
          src="https://docs.google.com/presentation/d/1UYDxYsJblhxWw_-TaOznAAtMQeZakYn18235f6aHyG4/embed?start=false&loop=false&delayms=3000"
          title="UC Davis Robotics Club project overview slides"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
      <a
        class="project-slides-link"
        href="https://docs.google.com/presentation/d/1UYDxYsJblhxWw_-TaOznAAtMQeZakYn18235f6aHyG4/edit?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open presentation in Google Slides
      </a>
    </div>
  </section>

  {archivedProjects.length > 0 && (
    <section class="section project-archive" aria-labelledby="project-archive-title">
      <div class="container">
        <p class="section-label">Archive</p>
        <h2 class="section-title" id="project-archive-title">Past Builds &amp; Legacy Projects</h2>
        <div class="project-archive-grid">
          {archivedProjects.map(p => (
            <article class="project-archive-card">
              <div class="project-archive-img-wrap">
                <img src={p.image} alt={p.title} class="project-archive-img" loading="lazy" decoding="async" />
              </div>
              <div class="project-archive-info">
                <h3>{p.title}</h3>
                <p>{p.year}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section training-cta" style="background:var(--surface-2);" aria-labelledby="training-title">
    <div class="container events-cta">
      <p class="section-label">Build with confidence</p>
      <h2 class="section-title" id="training-title" style="font-size:2rem;">Want to get certified to use machinery?</h2>
      <p class="section-body">
        Check out the ESDC website and sign up for training. Learn how to use mill, lathe, drill press and other tools safely and effectively, and get certified to use the ESDC lab.
      </p>
      <div class="cta-actions">
        <a
          href="https://design.engineering.ucdavis.edu/training"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          View Training
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
.projects-list {
  display: flex;
  flex-direction: column;
  gap: 4rem;
}

.project-archive {
  background: var(--surface-2);
  border-block: 1px solid var(--border);
}

.project-slides {
  padding-top: 0;
}

.project-slides .container {
  max-width: 1280px;
}

.project-slides-frame {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface);
}

.project-slides-frame iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
}

.project-slides-link {
  display: inline-block;
  margin-top: 0.75rem;
  color: var(--text-muted);
  font-size: 0.9rem;
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.project-archive-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  gap: 1rem;
  margin-top: 2rem;
}

.project-archive-card {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface);
}

.project-archive-img-wrap {
  height: 160px;
  overflow: hidden;
}

.project-archive-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.project-archive-info {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.9rem 1rem;
}

.project-archive-info h3 {
  font-size: 0.95rem;
  line-height: 1.4;
}

.project-archive-info p {
  flex: 0 0 auto;
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: 0.75rem;
}

.projects-hero { padding-bottom: 8px; }
.projects-content { padding-top: 48px; }

.member-project-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  margin: 1.5rem 0;
  padding: 1.5rem 1.75rem;
  border: 1px solid var(--border);
  border-left: 3px solid var(--gold);
  border-radius: 6px;
  background: var(--surface-2);
}

.member-project-banner .section-label {
  margin-bottom: 0.5rem;
}

.member-project-banner h2 {
  margin-bottom: 0.5rem;
  font-size: 1.2rem;
}

.member-project-banner p:not(.section-label) {
  max-width: 58ch;
  color: var(--text-muted);
  font-size: 0.9rem;
  line-height: 1.6;
}

.member-project-banner .btn {
  flex: 0 0 auto;
}

.project-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.project-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  padding-bottom: 4rem;
  border-bottom: 1px solid var(--border);
}

.project-row:last-child { border-bottom: none; }

.project-row:nth-child(even) .project-img { order: 2; }
.project-row:nth-child(even) .project-detail { order: 1; }

.project-tag-text {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--gold);
}

.project-status {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0.2em 0.65em;
  border-radius: 999px;
}

.status-active  { background: rgba(34,197,94,0.12); color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
.status-archived { background: rgba(239,68,68,0.12); color: #f87171; border: 1px solid rgba(239,68,68,0.3); }
.status-done    { background: rgba(100,100,120,0.2); color: var(--text-dim); border: 1px solid var(--border); }
.status-plan    { background: rgba(201,168,76,0.1); color: var(--gold); border: 1px solid rgba(201,168,76,0.3); }

.proj-title {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 800;
  margin-bottom: 1rem;
  color: var(--text);
}

.proj-desc {
  font-size: 0.95rem;
  color: var(--text-muted);
  line-height: 1.75;
  margin-bottom: 1.5rem;
}

.tech-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.tech-tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  padding: 0.3em 0.75em;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--text-muted);
}

 .project-img-wrap {
   height: 260px;
   border-radius: 6px;
   overflow: hidden;
   background: var(--surface);
   border: 1px solid var(--border);
 }

 .project-img {
   width: 100%;
   height: 100%;
   object-fit: cover;
   display: block;
 }

 .events-cta { max-width: 680px; }

.training-cta { border-block: 1px solid var(--border); }

.training-cta .cta-actions { margin-top: 1.5rem; }

.cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

@media (max-width: 700px) {
  .member-project-banner {
    align-items: flex-start;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  .project-row { grid-template-columns: 1fr; }
  .project-row:nth-child(even) .project-img-wrap { order: 0; }
  .project-row:nth-child(even) .project-detail { order: 0; }

}
</style>
